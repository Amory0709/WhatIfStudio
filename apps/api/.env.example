WHATIF_ENGINE_DIR=apps/api/engine
# Default: proven booth path (Deep-Live-Cam InSwapper + soft paste)
WHATIF_SWAP_MODEL=inswapper_128
# Identity vs portrait expression. Lower = keep gallery smile (0.72–0.78 booth sweet spot).
WHATIF_SWAP_SOURCE_WEIGHT=0.76
# Mouth/smile from gallery portrait (0=off, 1=full). Fixes creepy grins from upload.
WHATIF_PRESERVE_EXPRESSION=0.82
# Unsharp strength after swap (0=off, 0.45=default). Lower if too crunchy.
WHATIF_SWAP_SHARPNESS=0.45
# Poisson blend softens edges but blurs skin — off by default.
# WHATIF_POISSON_BLEND=1
# Prototype-only: FF box+XSeg mask + booth post (default booth ignores this).
# WHATIF_HYBRID_MASK=1
WATERMARK_TEXT=Created by AI
ALLOWED_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=10

# ---- Booth printer (CUPS) ---------------------------------------------
# Leave BOOTH_PRINTER_NAME empty to disable the server-side "Print Here"
# button. Visitors will still be able to use "Print via My Device" which
# calls window.print() on their own phone/computer.
# See docs/DEPLOY-MACMINI.md § "Booth printer setup" for end-to-end setup.
BOOTH_PRINTER_NAME=
BOOTH_MEDIA=Custom.102x152mm
BOOTH_COPIES=1
BOOTH_RESIZE_DPI=300
BOOTH_PRINT_TITLE=WhatIf Portrait

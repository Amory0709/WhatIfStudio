# ─── Node / Next.js ─────────────────────────────────────────────────────
node_modules/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts
.pnpm-store/
# Next.js static export (`output: 'export'`); rebuilt by Docker / CI
out/

# Fly.io machine state
.fly/

# Python bytecode (regenerated at build)
**/*.pyo

# ─── Python / FastAPI / swap engine ────────────────────────────────────
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Face-swap engine weights (re-vendor with the engine script; not in git)
apps/api/engine/*.pth

# ─── Runtime / logs ─────────────────────────────────────────────────────
*.log
*.pid
nohup.out
/tmp/*.log

# ─── OS junk ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ─── Local secrets / env ────────────────────────────────────────────────
.env
.env.local
.env.*.local
**/secrets.json
**/*.pem

# ─── User uploads (face photos customers paste in) ──────────────────────
apps/api/uploads/
apps/web/public/uploads/

# Models: inswapper_128.onnx + buffalo_l/* tracked via Git LFS (see .gitattributes).
# Only the redundant variants we never load stay ignored.
apps/api/engine/models/inswapper_128_fp16.onnx
# Runtime-generated by optimize_for_coreml() on Apple Silicon — re-derived on first swap.
apps/api/engine/models/*_coreml.onnx
apps/api/engine/models/GFPGANv1.4.pth
